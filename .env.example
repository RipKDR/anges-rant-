# Spotify Web API — powers /api/spotify/artist (live artist data & releases).
# Create an app at https://developer.spotify.com/dashboard to get credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The id from the artist page URL: https://open.spotify.com/artist/<id>
SPOTIFY_ARTIST_ID=

# YouTube Data API v3 — powers the video grid on the home page.
# Create an API key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3.
# Without this key the video section is hidden.
YOUTUBE_API_KEY=

# Production URL — used for SEO metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=https://angesrant.com
