# Spotify Web API — powers /api/spotify/artist (live artist data & releases).
# Create an app at https://developer.spotify.com/dashboard to get credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# The id from the artist page URL: https://open.spotify.com/artist/<id>
SPOTIFY_ARTIST_ID=

# YouTube Data API v3 — powers the video grid on the home page.
# Create an API key at https://console.cloud.google.com → APIs & Services → YouTube Data API v3.
# Without this key the video section is hidden.
YOUTUBE_API_KEY=

# Production URL — used for SEO metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=https://angesrant.com

# Resend — delivers booking-form enquiries (POST /api/booking).
# Create a key at https://resend.com/api-keys. Without it the form shows a
# graceful "email us directly" fallback instead of sending.
RESEND_API_KEY=
# Inbox that receives booking enquiries (defaults to the band's contact email).
BOOKING_TO_EMAIL=angesrant@outlook.com
# From address for enquiry emails. Use onboarding@resend.dev until you've
# verified a domain in Resend, then switch to e.g. bookings@angesrant.com.
BOOKING_FROM_EMAIL=Ange's Rant <onboarding@resend.dev>
